# === Database (PostgreSQL) cho Payload CMS ===
# Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URI=

# === Payload ===
PAYLOAD_SECRET=

# === Site ===
NEXT_PUBLIC_SITE_URL=https://novatech.demo

# === Email (tuỳ chọn, Giai đoạn 1) ===
# LEAD_NOTIFY_FROM chỉ điền ĐỊA CHỈ EMAIL thuần (vd: onboarding@resend.dev
# hoặc địa chỉ thuộc domain riêng đã xác minh trong Resend) — KHÔNG kèm tên
# hiển thị, code sẽ tự ghép "NovaTech Solutions <...>". Khi chưa xác minh
# domain riêng, Resend chỉ cho gửi tới đúng email của chủ tài khoản Resend.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# === Thanh toán MoMo (Giai đoạn 2) ===
# Để trống sẽ tự dùng bộ thông tin Test Environment công khai của MoMo
# (thanh toán "tiền giả" trên test-payment.momo.vn). Khi có tài khoản
# merchant thật từ https://business.momo.vn, điền thông tin thật vào đây và
# đổi MOMO_ENDPOINT sang https://payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=

# === Thanh toán VNPay (Giai đoạn 2) ===
# VNPay KHÔNG có bộ khóa test dùng chung công khai — phải tự đăng ký merchant
# test (miễn phí) tại https://sandbox.vnpayment.vn/devreg/ để nhận vnp_TmnCode
# + vnp_HashSecret riêng, rồi điền vào đây. Nếu để trống, hệ thống tự fallback
# sang trang mô phỏng thanh toán (/payment/simulate) để không chặn demo. Khi
# có tài khoản thật, đổi VNPAY_URL sang https://pay.vnpay.vn/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=

# === Thanh toán ZaloPay (Giai đoạn 2) ===
# Để trống sẽ tự dùng bộ thông tin Sandbox demo công khai của ZaloPay (app_id
# 2553, thanh toán "tiền giả"). Khi có tài khoản merchant thật từ
# https://merchant.zalopay.vn, điền thông tin thật vào đây và đổi
# ZALOPAY_ENDPOINT sang https://openapi.zalopay.vn/v2/create
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=

# === Analytics (tuỳ chọn) ===
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
